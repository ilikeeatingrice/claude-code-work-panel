{
  "name": "work-panel-demo",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts WorkPanelDemo out/work-panel-demo.mp4 --codec=h264 --crf=18 --audio-codec=aac --audio-bitrate=192k",
    "render:4x5": "remotion render src/index.ts WorkPanelDemo4x5 out/work-panel-demo-4x5.mp4 --codec=h264 --crf=18 --audio-codec=aac --audio-bitrate=192k",
    "audio": "${PYTHON:-python3} audio/make_track.py",
    "sync": "esbuild scripts/sync-table.ts --bundle --platform=node --log-level=warning | node",
    "gif": "bash scripts/gif.sh",
    "stills": "bash scripts/stills.sh"
  },
  "dependencies": {
    "@remotion/cli": "4.0.533",
    "@remotion/google-fonts": "4.0.533",
    "remotion": "4.0.533",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "typescript": "5.9.3"
  }
}
